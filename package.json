{
  "name": "aion-autonomous",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:core": "node --test tests/aion-core.test.js",
    "test:coin": "hardhat test tests/aion-coin.test.js",
    "compile:coin": "hardhat compile",
    "deploy:coin:testnet": "hardhat run scripts/deploy-aion-coin.js --network bscTestnet",
    "deploy:coin:mainnet": "hardhat run scripts/deploy-aion-coin.js --network bsc"
  },
  "devDependencies": {
    "hardhat": "^3.18.0",
    "@openzeppelin/contracts": "^5.6.1",
    "chai": "^6.2.2",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
    "@nomicfoundation/hardhat-mocha": "^3.1.0"
  },
  "dependencies": { "redis": "^6.2.1" }
}