# Production environment variables for AION
AION_PUBLIC_ORIGIN=https://aion-production-fbf3.up.railway.app

# Upstash Redis REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Railway native Redis (preferred when deployed on Railway)
REDIS_URL=

# PayPal (Sandbox by default)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Legacy alias still supported by the server
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
AION_VERIFY_SECRET=

# BNB Smart Chain / AION company treasury
AION_COMPANY_WALLET=
AION_TOKEN_ADDRESS=

# OpenAI gateway used by config/aion-openai-gateway.js
# A valid key may incur API charges. Configure spending limits with the provider.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_FRONTIER_MODEL=
OPENAI_ENGINEERING_MODEL=
OPENAI_RESEARCH_MODEL=
OPENAI_VOLUME_MODEL=
# Request timeout in milliseconds (1000-120000; default 30000)
OPENAI_REQUEST_TIMEOUT_MS=30000

# Groq is used by separate legacy/chat/mobile handlers
GROQ_API_KEY=

# Human approval gate for sensitive operations
AION_APPROVAL_TOKEN=

# Optional real robotics execution adapter (HTTPS endpoint)
AION_ROBOT_EXECUTOR_URL=
